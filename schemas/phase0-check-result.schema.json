{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formulabridge.local/schemas/phase0-check-result.schema.json",
  "title": "FormulaBridge Phase 0 check result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "checkId", "status", "assertions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "checkId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "status": { "$ref": "#/$defs/status" },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assertion" }
    }
  },
  "$defs": {
    "status": {
      "enum": ["passed", "failed", "blocked", "not-run"]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "status": { "$ref": "#/$defs/status" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["failed", "blocked", "not-run"] } },
            "required": ["status"]
          },
          "then": { "required": ["reason"] }
        }
      ]
    }
  }
}
