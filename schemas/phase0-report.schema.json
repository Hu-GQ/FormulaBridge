{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formulabridge.local/schemas/phase0-report.schema.json",
  "title": "FormulaBridge Phase 0 evidence report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "commit",
    "startedAt",
    "finishedAt",
    "overallStatus",
    "environment",
    "corpus",
    "checkSet",
    "checks"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "$ref": "#/$defs/nonEmptyString" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "finishedAt": { "$ref": "#/$defs/timestamp" },
    "overallStatus": { "$ref": "#/$defs/status" },
    "environment": {
      "$ref": "https://formulabridge.local/schemas/phase0-run.schema.json#/$defs/environment"
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "manifest", "sha256"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "manifest": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "checkSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "manifest", "sha256"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "manifest": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\]).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": ["passed", "failed", "blocked", "not-run"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location", "sha256", "sizeBytes"],
      "properties": {
        "kind": { "$ref": "#/$defs/nonEmptyString" },
        "location": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "startedAt",
        "finishedAt",
        "environment",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "$ref": "#/$defs/status" },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "finishedAt": { "$ref": "#/$defs/timestamp" },
        "environment": {
          "$ref": "https://formulabridge.local/schemas/phase0-run.schema.json#/$defs/environment"
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["passed", "failed"] } },
            "required": ["status"]
          },
          "then": {
            "properties": { "evidence": { "minItems": 1 } }
          }
        },
        {
          "if": {
            "properties": { "status": { "enum": ["blocked", "not-run"] } },
            "required": ["status"]
          },
          "then": { "required": ["reason"] }
        }
      ]
    }
  }
}
